#!/usr/bin/env bash
# zao-fetch-healthcheck.sh - Catch silent regressions in the keyless fetch trio.
#
# Doc 564 shipped "Reddit fetch FIXED + TESTED" and rotted ~3 weeks later with
# nobody noticing - the inbox kept indexing blocked HTML shells. This runs each
# fetcher against a known-stable target and asserts REAL content came back.
# Run weekly (cron) or on demand. Exit 0 = all green, non-zero = a fetcher regressed.
# Docs 822/823/824.

LOG="${SCOUT_LOG:-/tmp/scout-health.log}"
DIR="$(cd "$(dirname "$0")" && pwd)"
mkdir -p "$(dirname "$LOG")"
TS="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
FAIL=0   # a CRITICAL fetcher regressed -> exit 1
WARN=0   # only a BEST-EFFORT (mirror-volatile) fetcher is down -> still exit 0
report=""

# check NAME SCRIPT ARG NEEDLE TIER - array call, no eval.
# TIER: "critical" (X, Farcaster - stable first-party-style mirrors) or
#       "best-effort" (Reddit - the Redlib instance pool is volatile and often
#       Cloudflare-gated; its being down does NOT mean ZAOscout is broken).
check() {
  local name="$1" script="$2" arg="$3" needle="$4" tier="${5:-critical}"
  local out attempt
  # Retry once on miss - public mirrors blip; only a 2nd miss counts.
  for attempt in 1 2; do
    out="$("$script" "$arg" 2>/dev/null)"
    if echo "$out" | grep -qiE "$needle"; then
      report+="PASS  $name"$'\n'
      return
    fi
    [[ $attempt -eq 1 ]] && sleep 5
  done
  if [[ "$tier" == "best-effort" ]]; then
    report+="WARN  $name (best-effort mirror down - expected; ZAOscout still works)"$'\n'
    WARN=1
  else
    report+="FAIL  $name (no '$needle' after 2 tries; first 120b: ${out:0:120})"$'\n'
    FAIL=1
  fi
}

# X (FxTwitter) - a stable public tweet/article. CRITICAL.
check "x (FxTwitter)" "$DIR/scout-x" "2062149859394585061" "USER:|ARTICLE|TEXT:" "critical"
# Farcaster (Haatz) - dwr.eth profile (fid 3, permanent). CRITICAL.
check "farcaster (Haatz)" "$DIR/scout-farcaster" "3" "FID: 3|Dan Romero" "critical"
# Reddit (Redlib) - a subreddit listing. BEST-EFFORT (Redlib pool is Cloudflare-volatile).
check "reddit (Redlib)" "$DIR/scout-reddit" "r/announcements" "COMMENTS|post|TITLE|post_title" "best-effort"

printf "%s\n%s" "$TS" "$report" | tr -s '\n' >> "$LOG"
echo "[$TS] zao-fetch healthcheck:"
printf "%s" "$report"
if [[ $FAIL -ne 0 ]]; then
  echo "REGRESSION DETECTED - a CRITICAL fetcher (X or Farcaster) is broken. Re-validate per docs 822/823/824." >&2
  echo "FAIL $TS" >> "$LOG"
  exit 1
fi
if [[ $WARN -ne 0 ]]; then
  echo "all critical fetchers green; reddit degraded (volatile Redlib mirrors - best-effort, not a regression)."
  echo "WARN $TS" >> "$LOG"
  exit 0
fi
echo "all green"
echo "OK $TS" >> "$LOG"
