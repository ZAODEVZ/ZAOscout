# ZAOscout needs NO keys for the fetchers. Everything here is optional.

# Override the Redlib instance list (space-separated) if the defaults die.
# Refresh from https://github.com/redlib-org/redlib-instances
# REDLIB_INSTANCES="redlib.perennialte.ch reddit.rtrace.io redlib.privadency.com"

# Override the Farcaster hub mirror (default: haatz.quilibrium.com)
# FARCASTER_HUB="https://haatz.quilibrium.com"

# --- Only needed for the optional "capture from an email inbox" extension ---
# AGENTMAIL_API_KEY=

# --- Only needed for the optional "distribute" half (socials/newsletter) ---
# (left blank by design; v1 is capture-only)

# --- scout watch: deliver picks to Discord (pick ONE) ---
# Simplest: a channel webhook (no bot needed)
# DISCORD_WEBHOOK=https://discord.com/api/webhooks/...
# Or a bot-token DM to yourself (zero-dep raw REST):
# DISCORD_BOT_TOKEN=
# DISCORD_USER_ID=
#
# --- /research slash command: ask in Discord, get a brief back (see docs/DISCORD.md) ---
# Needs the API server running (npm run api) reachable at your Interactions Endpoint URL.
# DISCORD_PUBLIC_KEY=     # app "Public Key" - verifies Discord's signatures (required)
# DISCORD_APP_ID=         # application (client) id - to edit the reply + register the command
# DISCORD_GUILD_ID=       # your ZABAL server id - instant registration (omit = global, ~1h)
# (reuses DISCORD_BOT_TOKEN above to register the command; replies use the BYOK LLM + EXA keys below)
# Tuning:
# SCOUT_TOP=8                 # max picks per cycle
# SCOUT_WATCHLIST=./watchlist.json

# --- BYOK: optional LLM synthesis (a grounded "why it matters" per pick) ---
# Bring your own key for any one provider. No key set = link-only (still keyless).
# LLM_PROVIDER=openrouter        # openrouter | anthropic | openai | ollama
# LLM_API_KEY=                   # your key (not needed for ollama)
# LLM_MODEL=                     # optional; sensible default per provider
# (back-compat: OPENROUTER_API_KEY / ANTHROPIC_API_KEY / OPENAI_API_KEY / OLLAMA_URL also auto-detected)

# Optional: richer grounding via Exa web search (BYOK). No key = body-only.
# EXA_API_KEY=
